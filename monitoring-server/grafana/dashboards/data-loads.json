{
  "uid": "replica-dw-data-loads",
  "title": "DW replica - Data loads",
  "description": "When data is loaded into db-replica-01, from which source (replication or direct writes) and its impact.",
  "tags": [
    "mysql",
    "replication",
    "prod"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Summary",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Replication lag now",
      "description": "Seconds the replica is behind each primary (SHOW REPLICA STATUS). It rises while a large load arriving by replication is being applied and returns to 0 when it is done. Orange from 1 min, red from 5 min.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(mysql_slave_status_seconds_behind_master{instance=\"db-replica-01\"}, \"channel_name\", \"default\", \"channel_name\", \"^$\")",
          "legendFormat": "{{channel_name}} ({{master_host}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Replication threads",
      "description": "Running when both the IO thread (receives changes) and the SQL thread (applies them) are running for the channel. STOPPED means the replica no longer receives data from that primary.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(mysql_slave_status_slave_io_running{instance=\"db-replica-01\"} * mysql_slave_status_slave_sql_running{instance=\"db-replica-01\"}, \"channel_name\", \"default\", \"channel_name\", \"^$\")",
          "legendFormat": "{{channel_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STOPPED",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Running",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Rows written (last 24 h)",
      "description": "Rows inserted, updated or deleted in InnoDB in the last 24 hours, from any source (replication and direct writes on the replica).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(mysql_global_status_innodb_row_ops_total{instance=\"db-replica-01\",operation=~\"inserted|updated|deleted\"}[24h]))",
          "legendFormat": "Rows"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Direct write statements (last 24 h)",
      "description": "Write statements sent by clients connected to the replica (INSERT, UPDATE, DELETE, LOAD DATA...). Row-based replication does not count here, so a non-zero value means someone writes directly on the replica (read_only is OFF).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(mysql_global_status_commands_total{instance=\"db-replica-01\",command=~\"insert|insert_select|update|update_multi|delete|delete_multi|replace|replace_select|load|truncate\"}[24h]))",
          "legendFormat": "Statements"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
