{
  "uid": "data-transfer-demo",
  "title": "MySQL Data Transfer Attribution",
  "tags": [
    "mysql",
    "data-transfer",
    "demo"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Outbound bytes per schema, MySQL user and client IP from the MySQL slow log (log_slow_extra), compared with CloudWatch network metrics.",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total sent last 24h (slow log)",
      "description": "Sum of Bytes_sent of every statement in the MySQL slow log during the last 24 hours, all schemas, users and clients. Excludes monitoring users (exporter, root, debian-sys-maint).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(mysql_slowlog_bytes_sent_total[24h]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "bargauge",
      "title": "Bytes sent by schema (selected range)",
      "description": "Bytes_sent per schema in the dashboard time range. Schema = default database of the connection (from 'use <db>;' lines), not the tables read: cross-schema queries count under the default database.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (schema) (increase(mysql_slowlog_bytes_sent_total[$__range]))",
          "legendFormat": "{{schema}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput by schema",
      "description": "Outbound bytes per second per schema (5 minute rate of slow log Bytes_sent).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (schema) (rate(mysql_slowlog_bytes_sent_total[5m]))",
          "legendFormat": "{{schema}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 6
      }
    },
    {
      "type": "table",
      "title": "Top client IPs (selected range)",
      "description": "Top 10 client IPs by bytes sent. With NLB client IP preservation the real public IP of the consumer is visible; internal consumers show their VPC private IP.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(10, sum by (client_ip) (increase(mysql_slowlog_bytes_sent_total[$__range])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "client_ip": "Client IP",
              "Value": "Bytes sent"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Bytes sent",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Bytes by user and schema (selected range)",
      "description": "Bytes sent per MySQL user and schema. With one user per schema the attribution is exact; analyst_multi shows the cross-schema caveat.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (user, schema) (increase(mysql_slowlog_bytes_sent_total[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "user": "User",
              "schema": "Schema",
              "Value": "Bytes sent"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Bytes sent",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "NLB ProcessedBytes (CloudWatch, hourly)",
      "description": "Bytes processed by the Network Load Balancer per hour, both directions, including TCP/TLS overhead. Only traffic that goes through the NLB (internet and cross-region consumers); internal consumers do not appear here.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "region": "__AWS_REGION__",
          "namespace": "AWS/NetworkELB",
          "metricName": "ProcessedBytes",
          "dimensions": {
            "LoadBalancer": "__NLB_ARN_SUFFIX__"
          },
          "statistic": "Sum",
          "period": "3600",
          "matchExact": true,
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "ProcessedBytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "DB EC2 NetworkOut (CloudWatch, hourly)",
      "description": "Bytes sent by the DB instance network interface per hour: all traffic (MySQL through NLB and direct, plus Alloy pushes, package downloads). Compare with the slow log total: the slow log is lower because it excludes TCP/IP/TLS framing.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "region": "__AWS_REGION__",
          "namespace": "AWS/EC2",
          "metricName": "NetworkOut",
          "dimensions": {
            "InstanceId": "__DB_INSTANCE_ID__"
          },
          "statistic": "Sum",
          "period": "3600",
          "matchExact": true,
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "NetworkOut"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "MySQL global Bytes_sent vs slow log",
      "description": "mysqld exporter global status Bytes_sent (all sessions, including monitoring) next to the slow log total. They should track each other closely; a gap means statements missing from the slow log (e.g. long_query_time > 0) or excluded users.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(mysql_global_status_bytes_sent[5m])",
          "legendFormat": "global Bytes_sent",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(mysql_slowlog_bytes_sent_total[5m]))",
          "legendFormat": "slow log Bytes_sent",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Slow log entries (Loki)",
      "description": "Raw slow log entries of statements that took 1 second or more (Alloy drops faster ones before Loki). They contain the literal values of each query: restrict who can open this dashboard. Useful to inspect a specific slow execution, user or client IP.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{job=\"mysql-slowlog\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Slowest queries (selected range)",
      "description": "The 20 statements with the highest average time in the selected range, from MySQL's performance_schema. Statements are normalized (literal values replaced by ?), so the same query with different values is one row and no account numbers or personal data are shown. Total time shows which statements use the most database time overall. Only statements seen in the last 24 hours are tracked (the 250 most recent normalized statements).",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "topk(20, sum by (schema, digest_text) (increase(mysql_perf_schema_events_statements_seconds_total[$__range])) / (sum by (schema, digest_text) (increase(mysql_perf_schema_events_statements_total[$__range])) > 0))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "sum by (schema, digest_text) (increase(mysql_perf_schema_events_statements_total[$__range]))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "sum by (schema, digest_text) (increase(mysql_perf_schema_events_statements_seconds_total[$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "Value #A",
                "config": {
                  "id": "isNotNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value #A": 0,
              "Value #B": 1,
              "Value #C": 2,
              "schema": 3,
              "digest_text": 4
            },
            "renameByName": {
              "Value #A": "Avg time",
              "Value #B": "Executions",
              "Value #C": "Total time",
              "schema": "Schema",
              "digest_text": "Query (normalized)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Avg time",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Avg time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Executions"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Schema"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Avg time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Monitoring health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Active alerts",
      "description": "Alerts currently firing or pending (Prometheus rules in monitoring/prometheus/rules/alerts.yml). Firing alerts are emailed by Alertmanager. A malfunction alert means the numbers above may be incomplete for that period.",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 11,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "max by (alertname, severity, alertstate) (ALERTS{alertstate=~\"firing|pending\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "max by (alertname, severity) (ALERTS_FOR_STATE) * 1000"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "alertstate",
                "config": {
                  "id": "isNotNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2,
              "Value #B": 3
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "severity": "Severity",
              "Value #B": "Active since"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "All good: no active alerts"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "Firing",
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "text": "Pending",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Active since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Active since"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Alert history",
      "description": "When each alert was pending (orange) or firing (red). If a month shows less traffic, check here whether a malfunction alert overlapped it (lost data) before reading it as a real drop.",
      "gridPos": {
        "x": 11,
        "y": 42,
        "w": 13,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "{{alertname}}",
          "range": true,
          "instant": false,
          "expr": "max by (alertname) (ALERTS{alertstate=\"firing\"}) * 2 or max by (alertname) (ALERTS{alertstate=\"pending\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No alerts in this period",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Pending",
                  "color": "orange",
                  "index": 0
                },
                "2": {
                  "text": "Firing",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}
