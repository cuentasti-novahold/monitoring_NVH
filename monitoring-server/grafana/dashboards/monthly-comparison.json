{
  "uid": "data-transfer-monthly",
  "title": "Monthly Data Transfer Comparison",
  "description": "Month-over-month MySQL egress for management. Built on the 5-minute rollup rules in monitoring/prometheus/rules/egress-rollups.yml (data starts when the rules were first loaded). Calendar months use UTC.",
  "tags": [
    "mysql",
    "data-transfer",
    "monthly"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-12M/M",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "This month so far",
      "description": "Bytes sent by MySQL (slow log Bytes_sent) since the 1st of the current month, 00:00 UTC.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "timeFrom": "now/M",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(sum_over_time(schema:mysql_slowlog_bytes_sent:increase5m[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "hideTimeOverride": true
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Previous month",
      "description": "Bytes sent during the whole previous calendar month (UTC).",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "timeFrom": "now/M",
      "timeShift": "1M/M",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(sum_over_time(schema:mysql_slowlog_bytes_sent:increase5m[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "No data for that month yet"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "hideTimeOverride": true
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Change: last 30 days vs previous 30",
      "description": "Rolling comparison, so it is meaningful any day of the month (a calendar month in progress cannot be compared fairly with a complete one). Red = more egress (more cost), green = less. Needs 60 days of rollup data.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(sum_over_time(schema:mysql_slowlog_bytes_sent:increase5m[30d])) / sum(sum_over_time(schema:mysql_slowlog_bytes_sent:increase5m[30d] offset 30d)) - 1",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Needs 60 days of history",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "hideTimeOverride": true
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Top MySQL user this month",
      "description": "The MySQL user that pulled the most bytes since the 1st of the current month (UTC).",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "timeFrom": "now/M",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(1, sum by (user) (sum_over_time(user_client:mysql_slowlog_bytes_sent:increase5m[$__range])))",
          "legendFormat": "{{user}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "hideTimeOverride": true
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Bytes per calendar month by schema",
      "description": "Each bar is one calendar month (UTC); segments are schemas. Bar height = total egress of the month. The current month is still in progress. Schema = default database of the connection.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 11
      },
      "timeFrom": "now-12M/M",
      "interval": "1d",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (schema) (sum_over_time(schema:mysql_slowlog_bytes_sent:increase5m[1d] offset -1d))",
          "legendFormat": "{{schema}}",
          "interval": "1d",
          "range": true,
          "instant": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "formatTime",
          "options": {
            "timeField": "Time",
            "outputFormat": "YYYY-MM",
            "useTimezone": true
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Time": {
                "aggregations": [],
                "operation": "groupby"
              },
              "DW": {
                "aggregations": [
                  "sum"
                ],
                "operation": "aggregate"
              },
              "SALES": {
                "aggregations": [
                  "sum"
                ],
                "operation": "aggregate"
              },
              "FINANCE": {
                "aggregations": [
                  "sum"
                ],
                "operation": "aggregate"
              },
              "SUPPORT": {
                "aggregations": [
                  "sum"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Time": "Month",
              "DW (sum)": "DW",
              "SALES (sum)": "SALES",
              "FINANCE (sum)": "FINANCE",
              "SUPPORT (sum)": "SUPPORT"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "gradientMode": "none",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "DW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SALES"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FINANCE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SUPPORT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "Month",
        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "never",
        "groupWidth": 0.6,
        "barWidth": 0.97,
        "barRadius": 0,
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Change by schema: last 30 days vs previous 30",
      "description": "Positive = the schema sent more than in the previous 30 days (red, more cost); negative = less (green). Needs 60 days of rollup data.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (schema) (sum_over_time(schema:mysql_slowlog_bytes_sent:increase5m[30d])) / sum by (schema) (sum_over_time(schema:mysql_slowlog_bytes_sent:increase5m[30d] offset 30d)) - 1",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "schema": "Schema",
              "Value": "Change"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Schema",
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "always",
        "groupWidth": 0.6,
        "barWidth": 0.97,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Consumers: last 30 days vs previous 30",
      "description": "One row per MySQL user and client IP. Change = last 30 days / previous 30 days - 1 (empty when the consumer did not exist in the previous period).",
      "gridPos": {
        "x": 10,
        "y": 16,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (user, client_ip) (sum_over_time(user_client:mysql_slowlog_bytes_sent:increase5m[30d]))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (user, client_ip) (sum_over_time(user_client:mysql_slowlog_bytes_sent:increase5m[30d] offset 30d))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "user": "MySQL user",
              "client_ip": "Client IP",
              "Value #A": "Last 30 days",
              "Value #B": "Previous 30 days"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "Last 30 days",
              "operator": "/",
              "right": "Previous 30 days"
            },
            "alias": "Ratio",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "Ratio",
              "operator": "-",
              "right": "1"
            },
            "alias": "Change",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Ratio": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Last 30 days",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Change"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "nan",
                      "result": {
                        "text": "new",
                        "color": "text",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Monitoring health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Active alerts",
      "description": "Alerts currently firing or pending (Prometheus rules in monitoring/prometheus/rules/alerts.yml). Firing alerts are emailed by Alertmanager. A malfunction alert means the numbers above may be incomplete for that period.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 11,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "max by (alertname, severity, alertstate) (ALERTS{alertstate=~\"firing|pending\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false,
          "expr": "max by (alertname, severity) (ALERTS_FOR_STATE) * 1000"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "alertstate",
                "config": {
                  "id": "isNotNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2,
              "Value #B": 3
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "severity": "Severity",
              "Value #B": "Active since"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "All good: no active alerts"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "Firing",
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "text": "Pending",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Active since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Active since"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Alert history (last 7d)",
      "description": "When each alert was pending (orange) or firing (red). If a month shows less traffic, check here whether a malfunction alert overlapped it (lost data) before reading it as a real drop.",
      "gridPos": {
        "x": 11,
        "y": 26,
        "w": 13,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "{{alertname}}",
          "range": true,
          "instant": false,
          "expr": "max by (alertname) (ALERTS{alertstate=\"firing\"}) * 2 or max by (alertname) (ALERTS{alertstate=\"pending\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No alerts in this period",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Pending",
                  "color": "orange",
                  "index": 0
                },
                "2": {
                  "text": "Firing",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "timeFrom": "7d"
    }
  ]
}
